# FitTrack Pro - Environment Configuration
# Copy this file to .env and update with your settings

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3001

# ==========================================
# DATABASE CONFIGURATION - LOCAL SETUP
# ==========================================
# For local SQL Server on your machine
DB_SERVER=localhost
DB_PORT=1433
DB_ENCRYPT=false

# ==========================================
# AUTHENTICATION METHOD
# ==========================================
# Option 1: Windows Authentication (recommended for local Windows)
# Leave DB_USER and DB_PASSWORD empty to use Windows Authentication
# This uses your Windows login credentials automatically

# Option 2: SQL Server Authentication (use if Option 1 doesn't work)
# Uncomment and set these values:
# DB_USER=sa
# DB_PASSWORD=YourStrongPassword123!

# ==========================================
# FOR CLOUD DEPLOYMENT (Azure/AWS) - See CLOUD_MIGRATION.md
# ==========================================
# When deploying to cloud, update these:
# DB_SERVER=your-server.database.windows.net
# DB_ENCRYPT=true
# DB_USER=sqladmin
# DB_PASSWORD=YourCloudPassword123!
